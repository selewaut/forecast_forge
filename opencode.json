{
  "permission": {
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.pem": "deny",
      "*.key": "deny",
      "*.sqlite": "deny",
      "secrets/**": "deny",
      "private-data/**": "deny",
      ".git/credentials": "deny",
      "*credentials*": "deny",
      "*token*": "deny",
      "*auth*": "deny",
      "*password*": "deny",
      "*.kaggle*": "deny",
      "*.netrc": "deny",
      "*.env.example": "allow"
    }
    ,
    "bash": {
      "git status": "allow",
      "git rev-parse *": "allow",
      "git branch": "ask",
      "git checkout *": "ask",
      "git switch *": "ask",
      "git merge *": "ask",
      "git log": "allow",
      "git show": "allow",
      "git diff --name-only": "allow",
      "git diff": "ask",
      "git diff *": "ask",
      "git add *": "ask",
      "git commit *": "ask",
      "git push *": "ask",
      "gh pr view *": "allow",
      "gh pr list *": "allow",
      "gh pr diff *": "allow",
      "gh pr checks *": "allow",
      "gh pr status *": "allow",
      "gh issue view *": "allow",
      "gh issue list *": "allow",
      "gh run view *": "allow",
      "gh run list *": "allow",
      "gh search *": "allow",
      "git *": "ask",
      "*": "ask"
    }
    ,
    "external_directory": {
      "*": "allow",
      "~/.ssh/**": "deny",
      "~/.aws/**": "deny",
      "~/.kaggle/**": "deny",
      "~/.config/gh/**": "deny",
      "~/.config/gcloud/**": "deny",
      "~/.docker/**": "deny",
      "~/.netrc": "deny",
      "~/secrets/**": "deny",
      "~/Library/**": "deny",
      "/etc/**": "deny",
      "/private/**": "deny"
    }
    ,
    "edit": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      ".git/credentials": "deny",
      "secrets/**": "deny",
      "*.pem": "deny",
      "*.key": "deny",
      "*credentials*": "deny",
      "*token*": "deny",
      "*auth*": "deny",
      "*password*": "deny",
      "*.kaggle*": "deny"
    }
  }
}
